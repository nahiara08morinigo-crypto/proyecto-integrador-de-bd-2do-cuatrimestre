FROM persona
WHERE direccion = 'alumnos';

SELECT *
FROM persona
WHERE direccion = 'profesor';

SELECT *
FROM persona
WHERE direccion = 'preceptor';

SELECT *
FROM persona
WHERE direccion = 'auxiliar';

SELECT *
FROM persona
