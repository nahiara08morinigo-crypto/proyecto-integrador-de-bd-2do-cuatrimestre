FROM alumnos
WHERE curso LIKE '2do%';

SELECT COUNT(*) AS alumnos_de_tercero
FROM alumnos
WHERE curso LIKE '3ro%';

SELECT COUNT(*) AS alumnos_de_cuarto
FROM alumnos
WHERE curso LIKE '4to%';

SELECT COUNT(*) AS alumnos_de_quinto
FROM alumnos
WHERE curso LIKE '5to%';

SELECT materia, cursos_a_cargo
FROM profesores
ORDER BY materia;

SELECT curso, sexo, COUNT(*) AS cantidad
FROM alumnos
