create schema BD_Enfermedades_Argentina;
use BD_Enfermedades_Argentina;
create table enfermedades(
		idenfermedad Int primary key not null,
        nombre varchar (100) not null,
       descripcion varchar (100) not null,
		agentecasual varchar (100) not null
        );
	create table reportes(
		idreportes Int primary key not null,
        fecha_reporte varchar (100) not null,
        cantidad_casos int not null,
		cantidad_fellecidos int not null
        );
        create table Provincia(
		idprovincia Int primary key not null,
        nombre varchar (100) not null,
        region varchar (100) not null
        );
	   
